{
  "name": "amanah-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Amanah operational application layer for the Amanah Halal Trust Ecosystem (AHTE).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "web:build": "node scripts/apply-website-policy.mjs && node scripts/build-ecosystem-site.mjs && node scripts/refresh-ecosystem-shell.mjs && node scripts/finalize-website-provenance.mjs",
    "web:lint": "node scripts/check-ecosystem-site.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.2"
  }
}
